rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules → Publish.
// Only your two accounts (matched by email) can read or write anything.

service cloud.firestore {
  match /databases/{database}/documents {

    function isCouple() {
      return request.auth != null &&
        (request.auth.token.email == "methinkingcrazy@gmail.com" ||
         request.auth.token.email == "newannimsitha3@gmail.com");
    }

    match /couples/{coupleId}/{document=**} {
      allow read, write: if isCouple();
    }

    // Everything else is locked by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
